{
  "name": "imagebridge",
  "productName": "CtrlV",
  "version": "0.4.11",
  "description": "手机图片直达电脑剪贴板",
  "author": "ImageBridge",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "build": "tsc --noEmit && node build.mjs",
    "start": "electron .",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "koffi": "3.3.8",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.3.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "cn.local.imagebridge",
    "productName": "CtrlV",
    "directories": {
      "output": "../../release/windows"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/android/CtrlC.apk",
        "to": "CtrlC.apk"
      },
      {
        "from": "resources/ffprobe.exe",
        "to": "ffprobe.exe"
      },
      {
        "from": "resources/FFmpeg-LICENSE.txt",
        "to": "FFmpeg-LICENSE.txt"
      },
      {
        "from": "resources/FFmpeg-README.txt",
        "to": "FFmpeg-README.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "artifactName": "CtrlV-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "shortcutName": "CtrlV"
    }
  }
}
